    "    \"top_p\":          0.9,    # 0.0 to 1.0\n",
    "    \"top_k\":          40,     # 1 to 100+\n",
    "    \"num_predict\":    200,    # max tokens to generate\n",
    "    \"repeat_penalty\": 1.1,    # 1.0 = off, higher = less repetition\n",
    "    # \"stop\":         [\".\"],  # uncomment to stop at first period\n",
    "}\n",
    "\n",
    "# ============================================================\n",
